# Exported by Acme firewall
client
dev tun
proto udp
remote vpn.acme.com 1194
remote vpn2.acme.com 443 tcp
resolv-retry infinite
nobind
persist-key
persist-tun
auth-user-pass
cipher AES-256-GCM
route 10.20.0.0 255.255.0.0
route 192.168.50.0 255.255.255.0
verb 3
<ca>
-----BEGIN CERTIFICATE-----
MIIBCAFAKECA
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
MIIBCAFAKECERT
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN ENCRYPTED PRIVATE KEY-----
MIIFAKEENCRYPTEDKEY
-----END ENCRYPTED PRIVATE KEY-----
</key>
<tls-crypt>
-----BEGIN OpenVPN Static key V1-----
deadbeefdeadbeef
-----END OpenVPN Static key V1-----
</tls-crypt>
