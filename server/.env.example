# Required: random string with 32+ characters (e.g. `openssl rand -base64 48`).
NORTH_JWT_SECRET=change-me-change-me-change-me-change-me
# Shown in the desktop when someone adds this organization.
NORTH_ORGANIZATION_NAME=Minha Empresa
# `entra` (Microsoft sign-in) and/or `dev` (sign in by e-mail — testing only).
NORTH_AUTH_MODES=dev
# Production refuses `dev` unless you opt in explicitly.
NORTH_ALLOW_DEV_AUTH=1

# ── Entra ID (when NORTH_AUTH_MODES has `entra`) ──
# Entra admin center → App registrations → North → Overview.
# Directory (tenant) ID:
NORTH_OIDC_TENANT_ID=
# Application (client) ID:
NORTH_OIDC_CLIENT_ID=
# Optional: Entra group Object IDs (comma-separated) whose members are North admins.
# Needs the "groups" claim in the app's Token configuration. Empty = roles set in the panel.
NORTH_OIDC_ADMIN_GROUPS=
# 1 = anyone in the tenant may sign in (as a member with no projects); 0 = only people an admin added.
NORTH_OIDC_ALLOW_NEW_USERS=1
# Required in production: wraps every stored password (envelope encryption).
# Generate once with `openssl rand -base64 32` and back it up — losing it loses the passwords.
# Or point NORTH_MASTER_KEY_FILE at a file (Docker/K8s secret).
NORTH_MASTER_KEY=
