# Required: random string with 32+ characters (e.g. `openssl rand -base64 48`).
NORTH_JWT_SECRET=change-me-change-me-change-me-change-me
# Shown in the desktop when someone adds this organization.
NORTH_ORGANIZATION_NAME=Minha Empresa
# `entra` (phase 0, not wired yet) and/or `dev` (sign in by e-mail — testing only).
NORTH_AUTH_MODES=dev
# Production refuses `dev` unless you opt in explicitly.
NORTH_ALLOW_DEV_AUTH=1
