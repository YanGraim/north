#!/bin/sh
# north-vpn-helper v5
#
# Installed once, root-owned, next to root-owned copies of the VPN binaries. A sudoers
# rule lets the installing user run ONLY this file without a password, so it must never
# trust its caller: it takes no paths, runs only the binaries sitting next to it, reads
# the config from stdin into a root-only temp dir and accepts only whitelisted keys.
#
#   north-vpn-helper version     print the helper version
#   north-vpn-helper forti       openfortivpn with the config on stdin, log on stdout;
#                                SIGTERM stops the tunnel
#   north-vpn-helper ipsec       strongSwan charon-cmd, IKEv1 XAuth PSK (FortiGate dial-up);
#                                key=value lines on stdin, log on stdout; SIGTERM stops
#   north-vpn-helper stop-all    stop every tunnel this helper started (crash cleanup)
set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin
dir=$(cd "$(dirname "$0")" && pwd -P) || exit 70
umask 077

case "${1:-}" in
  version)
    echo 5
    ;;
  forti)
    bin="$dir/openfortivpn"
    [ -x "$bin" ] || { echo "ERROR:  north-vpn-helper: openfortivpn not installed"; exit 69; }
    tmp=$(mktemp -d /tmp/north-vpn.XXXXXX) || exit 70
    cfg="$tmp/config"
    head -c 65536 >"$cfg"
    if grep -Evq '^(host|port|username|password|realm|trusted-cert) = ' "$cfg"; then
      echo "ERROR:  north-vpn-helper: configuration option not allowed"
      rm -rf "$tmp"
      exit 64
    fi
    "$bin" -c "$cfg" 2>&1 &
    pid=$!
    trap 'kill -TERM "$pid" 2>/dev/null' TERM INT HUP
    n=0
    while kill -0 "$pid" 2>/dev/null; do
      # openfortivpn reads its config right away; don't keep the password on disk
      [ "$n" -eq 3 ] && rm -rf "$tmp"
      n=$((n + 1))
      sleep 1 &
      wait $!
    done
    rm -rf "$tmp"
    wait "$pid"
    ;;
  ipsec)
    bin="$dir/charon-cmd"
    [ -x "$bin" ] || { echo "north-vpn-helper: charon-cmd not installed"; exit 69; }
    host='' user='' id='' psk='' pw='' ike='' esp=''
    while IFS= read -r line; do
      case "$line" in
        host=*) host=${line#host=} ;;
        user=*) user=${line#user=} ;;
        id=*) id=${line#id=} ;;
        psk=*) psk=${line#psk=} ;;
        password=*) pw=${line#password=} ;;
        ike=*) ike=${line#ike=} ;;
        esp=*) esp=${line#esp=} ;;
        *) echo "north-vpn-helper: configuration option not allowed"; exit 64 ;;
      esac
    done
    # values become argv of a root process: no option smuggling, no odd characters
    for v in "$host" "$user"; do
      case "$v" in ''|-*|*[!A-Za-z0-9.:_@-]*) echo "north-vpn-helper: invalid value"; exit 64 ;; esac
    done
    case "$id" in -*|*[!A-Za-z0-9.:_@-]*) echo "north-vpn-helper: invalid value"; exit 64 ;; esac
    for v in "$ike" "$esp"; do
      case "$v" in ''|-*|*[!a-z0-9-]*) echo "north-vpn-helper: invalid value"; exit 64 ;; esac
    done
    tmp=$(mktemp -d /tmp/north-vpn.XXXXXX) || exit 70
    # root-owned: ignore the (user-writable) Homebrew strongswan.conf. IKE from UDP 500
    # like FortiClient (charon-cmd defaults to a random port + 4500, which FortiGate drops),
    # and flush every log line so North sees progress live.
    # Explicit plugin list (missing ones are skipped) so "unity" is loaded: it reads the
    # split-tunnel networks FortiGate pushes, like FortiClient, instead of taking all traffic.
    plugins='charon-cmd pkcs11 aes des sha1 sha2 md5 hmac random nonce x509 revocation constraints pubkey pkcs1 pkcs8 sshkey pem openssl gmp curve25519 kdf curl kernel-pfkey kernel-pfroute kernel-netlink socket-default eap-identity eap-md5 eap-gtc eap-mschapv2 eap-peap xauth-generic osx-attr resolve unity'
    printf '%s\n' 'charon-cmd {' "  load = $plugins" '  port = 500' '  port_nat_t = 4500' \
      '  filelog {' '    stderr {' '      default = 1' '      flush_line = yes' '    }' '  }' '}' \
      >"$tmp/strongswan.conf"
    set -- --host "$host" --remote-identity %any --profile ikev1-xauth-psk-am \
      --xauth-username "$user" --ike-proposal "$ike" --esp-proposal "$esp"
    # charon-cmd needs a local identity; FortiClient's "Local ID" when set, else the user
    set -- "$@" --identity "${id:-$user}"
    # charon-cmd asks for the PSK, then the XAuth password; without a tty it reads stdin
    printf '%s\n%s\n' "$psk" "$pw" | STRONGSWAN_CONF="$tmp/strongswan.conf" "$bin" "$@" 2>&1 &
    pid=$!
    psk='' pw=''
    trap 'kill -TERM "$pid" 2>/dev/null' TERM INT HUP
    while kill -0 "$pid" 2>/dev/null; do
      sleep 1 &
      wait $!
    done
    rm -rf "$tmp"
    wait "$pid"
    ;;
  stop-all)
    pkill -TERM -f "^$dir/openfortivpn " 2>/dev/null
    pkill -TERM -f "^$dir/charon-cmd " 2>/dev/null
    exit 0
    ;;
  *)
    echo "usage: north-vpn-helper version|forti|ipsec|stop-all" >&2
    exit 64
    ;;
esac
