#!/bin/sh
# north-vpn-helper v9
#
# Installed once, root-owned, next to root-owned copies of the VPN binaries. A sudoers
# rule lets the installing user run ONLY this file without a password, so it must never
# trust its caller: it takes no paths, runs only the binaries sitting next to it, reads
# the config from stdin into a root-only temp dir and accepts only whitelisted keys.
#
#   north-vpn-helper version     print the helper version
#   north-vpn-helper forti       openfortivpn with the config on stdin, log on stdout;
#                                SIGTERM stops the tunnel
#   north-vpn-helper ipsec       strongSwan charon-cmd, IKEv1 XAuth PSK (FortiGate dial-up);
#                                key=value lines on stdin, log on stdout; SIGTERM stops
#   north-vpn-helper openvpn     OpenVPN client: "port=", "mgmtpw=" lines, then the .ovpn
#                                (whitelisted directives, keys inline only) on stdin;
#                                credentials go over the localhost management socket
#   north-vpn-helper dns-set     split DNS (macOS /etc/resolver): "server=IP" and
#                                "domain=NAME" lines on stdin
#   north-vpn-helper dns-clear   remove North's resolver files for the "domain=" lines
#   north-vpn-helper stop-all    stop every tunnel this helper started and drop North's
#                                resolver files (crash cleanup)
set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin
dir=$(cd "$(dirname "$0")" && pwd -P) || exit 70
umask 077

case "${1:-}" in
  version)
    echo 9
    ;;
  forti)
    bin="$dir/openfortivpn"
    [ -x "$bin" ] || { echo "ERROR:  north-vpn-helper: openfortivpn not installed"; exit 69; }
    tmp=$(mktemp -d /tmp/north-vpn.XXXXXX) || exit 70
    cfg="$tmp/config"
    head -c 65536 >"$cfg"
    if grep -Evq '^(host|port|username|password|realm|trusted-cert) = ' "$cfg"; then
      echo "ERROR:  north-vpn-helper: configuration option not allowed"
      rm -rf "$tmp"
      exit 64
    fi
    "$bin" -c "$cfg" 2>&1 &
    pid=$!
    trap 'kill -TERM "$pid" 2>/dev/null' TERM INT HUP
    n=0
    while kill -0 "$pid" 2>/dev/null; do
      # openfortivpn reads its config right away; don't keep the password on disk
      [ "$n" -eq 3 ] && rm -rf "$tmp"
      n=$((n + 1))
      sleep 1 &
      wait $!
    done
    rm -rf "$tmp"
    wait "$pid"
    ;;
  ipsec)
    bin="$dir/charon-cmd"
    [ -x "$bin" ] || { echo "north-vpn-helper: charon-cmd not installed"; exit 69; }
    host='' user='' id='' psk='' pw='' ike='' esp=''
    while IFS= read -r line; do
      case "$line" in
        host=*) host=${line#host=} ;;
        user=*) user=${line#user=} ;;
        id=*) id=${line#id=} ;;
        psk=*) psk=${line#psk=} ;;
        password=*) pw=${line#password=} ;;
        ike=*) ike=${line#ike=} ;;
        esp=*) esp=${line#esp=} ;;
        *) echo "north-vpn-helper: configuration option not allowed"; exit 64 ;;
      esac
    done
    # values become argv of a root process: no option smuggling, no odd characters
    for v in "$host" "$user"; do
      case "$v" in ''|-*|*[!A-Za-z0-9.:_@-]*) echo "north-vpn-helper: invalid value"; exit 64 ;; esac
    done
    case "$id" in -*|*[!A-Za-z0-9.:_@-]*) echo "north-vpn-helper: invalid value"; exit 64 ;; esac
    for v in "$ike" "$esp"; do
      case "$v" in ''|-*|*[!a-z0-9-]*) echo "north-vpn-helper: invalid value"; exit 64 ;; esac
    done
    tmp=$(mktemp -d /tmp/north-vpn.XXXXXX) || exit 70
    # root-owned: ignore the (user-writable) Homebrew strongswan.conf. IKE from UDP 500
    # like FortiClient (charon-cmd defaults to a random port + 4500, which FortiGate drops),
    # and flush every log line so North sees progress live.
    # Explicit plugin list (missing ones are skipped) so "unity" is loaded: it reads the
    # split-tunnel networks FortiGate pushes, like FortiClient, instead of taking all traffic.
    plugins='charon-cmd pkcs11 aes des sha1 sha2 md5 hmac random nonce x509 revocation constraints pubkey pkcs1 pkcs8 sshkey pem openssl gmp curve25519 kdf curl kernel-pfkey kernel-pfroute kernel-netlink socket-default eap-identity eap-md5 eap-gtc eap-mschapv2 eap-peap xauth-generic osx-attr resolve unity'
    # Windows (North's WSL distro, marked by /etc/north-wsl): ESP in userspace on a TUN
    # (no dependency on the WSL kernel's XFRM), and Windows' traffic for the VPN's networks
    # — routed here by north-vpn-service — is forwarded into the tunnel and NATed to it.
    if [ -f /etc/north-wsl ]; then
      plugins="$plugins kernel-libipsec"
      sysctl -qw net.ipv4.ip_forward=1
      iptables -t nat -C POSTROUTING -o ipsec+ -j MASQUERADE 2>/dev/null ||
        iptables -t nat -A POSTROUTING -o ipsec+ -j MASQUERADE
    fi
    printf '%s\n' 'charon-cmd {' "  load = $plugins" '  cisco_unity = yes' '  port = 500' '  port_nat_t = 4500' \
      '  filelog {' '    stderr {' '      default = 1' '      flush_line = yes' '    }' '  }' '}' \
      >"$tmp/strongswan.conf"
    set -- --host "$host" --remote-identity %any --profile ikev1-xauth-psk-am \
      --xauth-username "$user" --ike-proposal "$ike" --esp-proposal "$esp"
    # charon-cmd needs a local identity; FortiClient's "Local ID" when set, else the user
    set -- "$@" --identity "${id:-$user}"
    # charon-cmd asks for the PSK, then the XAuth password; without a tty it reads stdin
    printf '%s\n%s\n' "$psk" "$pw" | STRONGSWAN_CONF="$tmp/strongswan.conf" "$bin" "$@" 2>&1 &
    pid=$!
    psk='' pw=''
    trap 'kill -TERM "$pid" 2>/dev/null' TERM INT HUP
    while kill -0 "$pid" 2>/dev/null; do
      sleep 1 &
      wait $!
    done
    rm -rf "$tmp"
    wait "$pid"
    ;;
  openvpn)
    bin="$dir/openvpn"
    [ -x "$bin" ] || { echo "north-vpn-helper: openvpn not installed"; exit 69; }
    IFS= read -r l1 && IFS= read -r l2 || { echo "north-vpn-helper: invalid input"; exit 64; }
    case "$l1" in port=*) port=${l1#port=} ;; *) echo "north-vpn-helper: invalid input"; exit 64 ;; esac
    case "$l2" in mgmtpw=*) mgmtpw=${l2#mgmtpw=} ;; *) echo "north-vpn-helper: invalid input"; exit 64 ;; esac
    case "$port" in ''|*[!0-9]*) echo "north-vpn-helper: invalid port"; exit 64 ;; esac
    [ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || { echo "north-vpn-helper: invalid port"; exit 64; }
    case "$mgmtpw" in ''|*[!0-9a-f]*) echo "north-vpn-helper: invalid input"; exit 64 ;; esac
    tmp=$(mktemp -d /tmp/north-vpn.XXXXXX) || exit 70
    cfg="$tmp/client.ovpn"
    head -c 1048576 >"$cfg"
    printf '%s\n' "$mgmtpw" >"$tmp/mgmt"
    # An .ovpn runs as root: only plain client directives; certificates/keys must be inline
    # blocks (no paths), no scripts, plugins, management or file options.
    if ! awk '
      { sub(/\r$/, "") }
      inblock { if ($0 == "</" tag ">") inblock = 0; next }
      /^[ \t]*([#;]|$)/ { next }
      /^<[a-z0-9-]+>$/ {
        tag = substr($0, 2, length($0) - 2)
        if (tag ~ /^(ca|cert|key|tls-auth|tls-crypt|tls-crypt-v2|pkcs12|extra-certs|peer-fingerprint|secret)$/) { inblock = 1; next }
        print "north-vpn-helper: block not allowed: " tag; exit 1
      }
      $1 == "auth-user-pass" && NF > 1 { print "north-vpn-helper: auth-user-pass file not allowed"; exit 1 }
      $1 !~ /^(client|dev|dev-type|proto|remote|remote-random|remote-random-hostname|resolv-retry|nobind|persist-key|persist-tun|remote-cert-tls|ns-cert-type|verify-x509-name|cipher|ciphers|data-ciphers|data-ciphers-fallback|ncp-ciphers|ncp-disable|auth|comp-lzo|compress|allow-compression|verb|mute|mute-replay-warnings|key-direction|key-method|tls-client|tls-version-min|tls-version-max|tls-cipher|tls-ciphersuites|tls-groups|tls-timeout|tls-exit|reneg-sec|reneg-bytes|hand-window|tran-window|replay-window|keepalive|ping|ping-restart|ping-exit|inactive|float|route|route-ipv6|route-nopull|route-delay|route-metric|redirect-gateway|pull|pull-filter|dhcp-option|block-outside-dns|tun-mtu|tun-mtu-extra|link-mtu|mssfix|fragment|mtu-disc|txqueuelen|sndbuf|rcvbuf|fast-io|passtos|explicit-exit-notify|server-poll-timeout|connect-retry|connect-retry-max|connect-timeout|topology|port|lport|rport|bind|push-peer-info|auth-nocache|auth-token|auth-token-user|static-challenge|setenv|ignore-unknown-option|ifconfig-nowarn|tun-ipv6|opt-verify|machine-readable-output|x509-track|auth-user-pass)$/ { print "north-vpn-helper: option not allowed: " $1; exit 1 }
    ' "$cfg"; then
      rm -rf "$tmp"
      exit 64
    fi
    "$bin" --config "$cfg" --script-security 1 --management 127.0.0.1 "$port" "$tmp/mgmt" \
      --management-query-passwords --management-hold --auth-nocache --auth-retry none 2>&1 &
    pid=$!
    trap 'kill -TERM "$pid" 2>/dev/null' TERM INT HUP
    n=0
    while kill -0 "$pid" 2>/dev/null; do
      # openvpn reads the config and the management password at startup
      [ "$n" -eq 5 ] && rm -rf "$tmp"
      n=$((n + 1))
      sleep 1 &
      wait $!
    done
    rm -rf "$tmp"
    wait "$pid"
    ;;
  dns-set|dns-clear)
    [ "$(uname)" = Darwin ] || { echo "north-vpn-helper: split DNS only on macOS for now"; exit 69; }
    server='' domains=''
    while IFS= read -r line; do
      case "$line" in
        server=*) server=${line#server=} ;;
        domain=*)
          d=${line#domain=}
          case "$d" in ''|.*|-*|*..*|*[!A-Za-z0-9.-]*) echo "north-vpn-helper: invalid domain"; exit 64 ;; esac
          domains="$domains $d"
          ;;
        *) echo "north-vpn-helper: option not allowed"; exit 64 ;;
      esac
    done
    [ -d /etc/resolver ] || { mkdir /etc/resolver && chmod 755 /etc/resolver; }
    for d in $domains; do
      f="/etc/resolver/$d"
      # never touch a resolver file North didn't write
      if [ -e "$f" ] && ! grep -q '^# north-vpn$' "$f"; then
        echo "north-vpn-helper: /etc/resolver/$d belongs to something else, skipped"
        continue
      fi
      if [ "$1" = dns-set ]; then
        case "$server" in ''|*[!0-9.]*) echo "north-vpn-helper: invalid server"; exit 64 ;; esac
        printf '# north-vpn\nnameserver %s\n' "$server" >"$f"
        chmod 644 "$f"
      else
        rm -f "$f"
      fi
    done
    ;;
  stop-all)
    pkill -TERM -f "^$dir/openfortivpn " 2>/dev/null
    pkill -TERM -f "^$dir/charon-cmd " 2>/dev/null
    pkill -TERM -f "^$dir/openvpn " 2>/dev/null
    if [ -d /etc/resolver ]; then
      for f in /etc/resolver/*; do
        [ -f "$f" ] && grep -q '^# north-vpn$' "$f" && rm -f "$f"
      done
    fi
    exit 0
    ;;
  *)
    echo "usage: north-vpn-helper version|forti|ipsec|openvpn|dns-set|dns-clear|stop-all" >&2
    exit 64
    ;;
esac
